{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yelp-review.schema.json",
  "title": "Yelp prepared-review handoff record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "text",
    "user_id",
    "stars",
    "review_date",
    "business_id",
    "business_name",
    "categories",
    "city",
    "state"
  ],
  "properties": {
    "doc_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "user_id": {"type": ["string", "null"], "minLength": 1},
    "stars": {
      "type": ["number", "null"],
      "minimum": 1,
      "maximum": 5,
      "multipleOf": 0.5
    },
    "review_date": {"type": ["string", "null"], "format": "date"},
    "business_id": {"type": ["string", "null"], "minLength": 1},
    "business_name": {"type": ["string", "null"], "minLength": 1},
    "categories": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        {"type": "null"}
      ]
    },
    "city": {"type": ["string", "null"], "minLength": 1},
    "state": {"type": ["string", "null"], "minLength": 1}
  }
}
